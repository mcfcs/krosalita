# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env files (keep .env.example tracked)
.env
.env.*
!.env.example

# Debug captures (HAR files contain session cookies — never commit)
context/
*.har

# Vercel CLI
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
venv

.vercel
# NOTE: this must not be a bare `.env*` — that silently re-ignores .env.example,
# which is tracked on purpose as the documentation of which vars are needed.
.env
.env.local
.env.*.local

# Pipeline: live SQLite state (held open by the monitor) and bulk intermediates
pipeline/state.sqlite*
pipeline/out/
pipeline/__pycache__/
**/__pycache__/
# e2e screenshots are build artifacts, not source
scripts/*-e2e.png
