# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local env files (keep .env.example tracked)
.env
.env.*
!.env.example

# Debug captures (HAR files contain session cookies — never commit)
context/
*.har

# Vercel CLI
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
venv

.vercel
# NOTE: this must not be a bare `.env*` — that silently re-ignores .env.example,
# which is tracked on purpose as the documentation of which vars are needed.
.env
.env.local
.env.*.local

# Pipeline: live SQLite state (held open by the monitor) and bulk intermediates
pipeline/state.sqlite*
pipeline/out/
pipeline/__pycache__/
**/__pycache__/
# e2e screenshots are build artifacts, not source
scripts/*-e2e.png

# Bulk source data and scratch notebooks.
#
# These are NOT in the repo on purpose. public/ is copied into dist/ and deployed, so
# anything here was also being served from the live site. The app needs only
# crosswords.csv, corpus/ and the tagalog CSV; everything below is either pipeline input
# or a scratch notebook, and the notebooks additionally embed local absolute paths.
# They now live in pipeline/data/, which is never served. Keep your own copy of
# nytcrosswordspure.csv there to run the pipeline.
pipeline/data/
.ipynb_checkpoints/
